# Godot 4+ specific ignores
.godot/
/android/

# Editor-local overrides. override.cfg lets one machine change project
# settings without touching project.godot, so it must never be shared.
override.cfg

# Manual scene snapshots taken while building the levels (*.tscn.bak,
# *.tscn.bak2, *.tscn.prelab.bak, *.tscn.preseminar.bak, *.tscn.pre_npc.bak).
# These are working scratch, not history — git is the history.
*.bak
*.bak2
*.tmp

# Dev screenshots written by tools/shot.gd and friends (~17MB, regenerated by
# re-running those scripts). Their .import sidecars go with them.
tools/shots/

# Compiled translations, generated from source .csv/.po at build time
*.translation

# C# / .NET, if the project ever gains script assemblies
.mono/
data_*/
*.csproj
*.sln


# --- deliberately NOT ignored -----------------------------------------------
#
# *.uid       Godot 4.4+ writes a .uid beside every script. They must be
#             committed: they are how scenes reference scripts by stable id
#             rather than by path, and deleting them silently breaks those
#             references for everyone else.
#
# *.import    Import settings for every asset. Committed so a fresh clone
#             re-imports the .glb/.png files identically. (The *output* of
#             that import lives in .godot/, which is ignored.)
#
# export_presets.cfg
#             Committed so the Windows export is reproducible. Safe here
#             because it uses a relative export_path and holds no
#             credentials — if an Android preset with a keystore password is
#             ever added, move this file to the ignore list above.
